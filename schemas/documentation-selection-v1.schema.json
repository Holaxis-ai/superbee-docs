{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getsuperbee.com/schemas/superbee-docs-documentation-selection/v1",
  "title": "Superbee documentation selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "supportingDocuments"],
  "properties": {
    "schema": {
      "const": "https://getsuperbee.com/schemas/superbee-docs-documentation-selection/v1"
    },
    "supportingDocuments": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
      }
    },
    "agentGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "heading", "label"],
      "properties": {
        "documentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "heading": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
