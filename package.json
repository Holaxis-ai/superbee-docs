{
  "name": "superbee-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public, source-grounded documentation for Superbee.",
  "workspaces": [
    "tooling/diagram-pipeline"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tools:bootstrap": "node scripts/bootstrap-tools.mjs",
    "docs:release": "node scripts/release-docs.mjs update",
    "docs:release:check": "node scripts/release-docs.mjs check",
    "diagram:build": "node scripts/apply-diagrams.mjs",
    "diagram:check": "node tooling/diagram-pipeline/cli.mjs check --root . --manifest diagrams/manifest.json",
    "bundle:check": "node scripts/validate.mjs",
    "portal:check": "superbee-portal check --config portal.config.json --json",
    "portal:build": "superbee-portal build --config portal.config.json --json",
    "portal:preview": "superbee-portal preview --config portal.config.json --json",
    "cloudflare:check": "wrangler deploy --dry-run",
    "cloudflare:preview": "wrangler versions upload",
    "cloudflare:deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs tooling/diagram-pipeline/test/*.test.mjs",
    "check": "npm run diagram:check && npm run docs:release:check && npm run bundle:check && npm run portal:check && npm run portal:build && npm run cloudflare:check && npm test"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
