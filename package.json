{
  "name": "superbee-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public, source-grounded documentation for Superbee.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:snapshot": "node scripts/hosted-content.mjs snapshot",
    "content:checkout": "node scripts/content-writer.mjs checkout",
    "content:sync": "node scripts/content-writer.mjs sync",
    "content:run": "node scripts/content-writer.mjs --",
    "repository-history:ensure": "node scripts/bootstrap-repository-history.mjs",
    "source:sync": "node scripts/sync-source.mjs",
    "docs:release": "node scripts/content-writer.mjs -- node scripts/release-docs.mjs update",
    "docs:release:archive": "node scripts/content-writer.mjs -- node scripts/release-docs.mjs archive",
    "docs:release:status": "node scripts/release-maintenance.mjs",
    "docs:release:prepare": "node scripts/release-conductor.mjs prepare",
    "docs:release:apply": "node scripts/content-writer.mjs -- node scripts/release-conductor.mjs apply",
    "docs:release:verify": "node scripts/content-writer.mjs -- node scripts/release-conductor.mjs check",
    "deployment:preflight": "node scripts/deployment-preflight.mjs",
    "docs:release:check": "node scripts/release-docs.mjs check",
    "cli-reference:build": "node scripts/content-writer.mjs -- node scripts/cli-reference.mjs build",
    "cli-reference:check": "node scripts/cli-reference.mjs check",
    "architecture:check": "node scripts/architecture-docs.mjs check --source .deps/source/superbee",
    "architecture:impact": "node scripts/architecture-docs.mjs impact --source .deps/source/superbee",
    "docs:impact": "node scripts/documentation-impact.mjs",
    "docs:impact:check": "node scripts/documentation-impact.mjs check",
    "diagram:build": "node scripts/content-writer.mjs -- superbee-docs diagram apply --root . --config portal.config.json",
    "diagram:upgrade-static": "node scripts/content-writer.mjs -- superbee-docs diagram upgrade-static --root . --config portal.config.json",
    "diagram:rollback": "node scripts/content-writer.mjs -- superbee-docs diagram rollback --root . --config portal.config.json",
    "diagram:check": "superbee-docs diagram check --root . --config portal.config.json",
    "prose:check": "node scripts/prose-style.mjs",
    "bundle:check": "node scripts/validate.mjs",
    "portal:check": "node scripts/documentation-outputs.mjs check",
    "portal:build": "node scripts/documentation-outputs.mjs build && node scripts/deployment-assets.mjs",
    "portal:preview": "node scripts/documentation-outputs.mjs preview",
    "mkdocs:sync": "superbee-docs-mkdocs sync",
    "mkdocs:build": "superbee-docs-mkdocs build",
    "cloudflare:check": "wrangler deploy --dry-run",
    "cloudflare:reconciliation:check": "node scripts/check-cloudflare-reconciliation.mjs",
    "cloudflare:reconcile": "node scripts/reconcile-cloudflare.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run package-verification:check && npm run diagram:check && npm run docs:release:check && npm run cli-reference:check && npm run release-package:check && npm run architecture:check && npm run docs:impact:check && npm run prose:check && npm run bundle:check && npm run portal:check && npm run portal:build && npm run mkdocs:build && npm run cloudflare:check && npm run cloudflare:reconciliation:check && npm test",
    "docs:release:finalize": "node scripts/content-writer.mjs -- node scripts/release-conductor.mjs finalize",
    "release-package:check": "node scripts/release-package-journeys.mjs",
    "package-verification:check": "node scripts/check-package-verification.mjs",
    "assistant:eval": "superbee-portal-assistant-eval --artifact dist --config scripts/assistant-config.mjs --questions assistant/golden-questions.md",
    "assistant:eval:check": "node scripts/assistant-eval-check.mjs"
  },
  "dependencies": {
    "@superbee/agent-operations": "0.1.0-pre.4",
    "@superbee/assistant-runtime": "0.1.0-pre.21",
    "@superbee/core": "0.2.0-pre.17",
    "@superbee/docs-mkdocs": "0.2.2",
    "@superbee/docs-projection": "0.2.5",
    "@superbee/docs-tooling": "0.2.5",
    "@superbee/portal": "0.2.13",
    "@superbee/portal-cloudflare": "0.2.15",
    "@superbee/portal-docs": "0.2.11",
    "@superbee/portal-webmcp": "0.3.2",
    "@superbee/recipe-studio": "0.1.3",
    "superbee": "0.4.3",
    "superbee-writer": "npm:superbee@0.4.3-pre.23"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  },
  "overrides": {
    "@superbee/recipe-studio": {
      "@superbee/core": "$@superbee/core"
    }
  }
}
