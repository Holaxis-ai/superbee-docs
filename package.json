{
  "name": "superbee-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public, source-grounded documentation for Superbee.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tools:bootstrap": "node scripts/bootstrap-tools.mjs",
    "docs:release": "node scripts/release-docs.mjs update",
    "docs:release:check": "node scripts/release-docs.mjs check",
    "diagram:build": "superbee-docs diagram apply --root . --config portal.config.json",
    "diagram:rollback": "superbee-docs diagram rollback --root . --config portal.config.json",
    "diagram:check": "superbee-docs diagram check --root . --config portal.config.json",
    "bundle:check": "node scripts/validate.mjs",
    "portal:check": "superbee-docs check --config portal.config.json",
    "portal:build": "superbee-docs build --config portal.config.json",
    "portal:preview": "superbee-docs preview --config portal.config.json",
    "cloudflare:check": "wrangler deploy --dry-run",
    "cloudflare:preview": "wrangler versions upload",
    "cloudflare:deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "check": "npm run diagram:check && npm run docs:release:check && npm run bundle:check && npm run portal:check && npm run portal:build && npm run cloudflare:check && npm test"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
