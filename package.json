{
  "name": "superbee-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public, source-grounded documentation for Superbee.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tools:bootstrap": "node scripts/bootstrap-tools.mjs",
    "docs:release": "node scripts/release-docs.mjs update",
    "docs:release:check": "node scripts/release-docs.mjs check",
    "architecture:check": "node scripts/architecture-docs.mjs check --source .deps/source/superbee",
    "architecture:impact": "node scripts/architecture-docs.mjs impact --source .deps/source/superbee",
    "diagram:build": "superbee-docs diagram apply --root . --config portal.config.json",
    "diagram:upgrade-static": "superbee-docs diagram upgrade-static --root . --config portal.config.json",
    "diagram:rollback": "superbee-docs diagram rollback --root . --config portal.config.json",
    "diagram:check": "superbee-docs diagram check --root . --config portal.config.json",
    "prose:check": "node scripts/prose-style.mjs",
    "bundle:check": "node scripts/validate.mjs",
    "portal:check": "node scripts/documentation-outputs.mjs check",
    "portal:build": "node scripts/documentation-outputs.mjs build",
    "portal:preview": "node scripts/documentation-outputs.mjs preview",
    "mkdocs:sync": "node scripts/mkdocs-runtime.mjs sync",
    "mkdocs:build": "node scripts/mkdocs-runtime.mjs build",
    "cloudflare:check": "wrangler deploy --dry-run",
    "cloudflare:preview": "wrangler versions upload",
    "cloudflare:deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "check": "npm run diagram:check && npm run docs:release:check && npm run architecture:check && npm run prose:check && npm run bundle:check && npm run portal:check && npm run portal:build && npm run mkdocs:build && npm run cloudflare:check && npm test"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
