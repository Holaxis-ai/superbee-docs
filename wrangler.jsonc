{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superbee-docs",
  "main": "./scripts/cloudflare-worker.mjs",
  "account_id": "454536c8fb003eaa679b986bd11dfe49",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "docs.getsuperbee.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./deploy",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/data/*",
      "/bundle/*",
      "/__superbee/bridge/*"
    ]
  }
}
