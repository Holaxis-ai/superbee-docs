flowchart TB
  accTitle: Superbee architecture at a glance
  accDescr {
    The installed superbee package composes the reusable command runtime, host adapters, and
    capabilities. Those packages depend inward on core, which owns bundle semantics and storage
    contracts. The current stable package ships publication modules and built UI assets beside the
    CLI. The diagram groups ownership rather than enumerating every dependency.
  }

  subgraph distribution["Composition and distribution: current stable"]
    cli["superbee<br/>installed CLI and declared exports"]
    publicModules["stable read-only exports<br/>snapshot, descriptor, portable-export"]
  end

  subgraph hosts["Host and projection composites"]
    hostAdapters["ui-server · mcp-app · ui"]
    publication["publication"]
  end

  subgraph capabilities["Reusable capabilities"]
    reusable["board-git · server<br/>view-runtime · markdown-renderer"]
  end

  subgraph semantics["OKF semantic and storage base"]
    core["core"]
  end

  runtime["@superbee/cli<br/>command runtime"]
  cli -->|"bundles"| runtime
  runtime -->|"composes hosts"| hostAdapters
  publicModules -. "built beside CLI" .-> publication

  hostAdapters -->|"use selected capabilities"| reusable
  publication -->|"uses reusable capabilities"| reusable
  reusable -->|"depends inward"| core
